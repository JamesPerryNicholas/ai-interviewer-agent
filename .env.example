# Application
APP_ENV=production
APP_NAME=AI_Interview_Agent_Backend
DEBUG=false

# Local development connection URLs
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_interviewer
REDIS_URL=redis://localhost:6379/0

# JWT authentication
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=120
JWT_ISSUER=ai-interviewer-agent
JWT_AUDIENCE=ai-interviewer-web

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_TIMEOUT_SECONDS=120
DEEPSEEK_QUESTION_MAX_TOKENS=1800
DEEPSEEK_EVALUATION_MAX_TOKENS=2600

# Admin console bootstrap account
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_BUDGET_TOKENS=

# Browser origins, comma separated. Prefer same-origin in production.
CORS_ORIGINS=https://your-domain.example
TRUSTED_PROXY_NETWORKS=127.0.0.1/32,::1/128,172.16.0.0/12

# Upload and content limits
MAX_RESUME_UPLOAD_BYTES=10485760
MAX_PDF_PAGES=50
MAX_RESUME_TEXT_CHARS=80000
MAX_JOB_DESCRIPTION_CHARS=20000
MAX_AVATAR_UPLOAD_BYTES=5242880
RATE_LIMIT_FAIL_CLOSED=true
DISTRIBUTED_LOCK_TTL_SECONDS=600

# Docker 宿主机端口
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Docker Compose service configuration
POSTGRES_DB=ai_interviewer
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
REDIS_PASSWORD=
REDIS_PORT=6379
